# second-brain-ics settings. Copy to .env (a source checkout) or to a file you name with
# --env-file, and keep it readable by you only: a feed's address is a secret.

# The feeds, by name (lower-case letters, digits, underscores), and each one's address.
SBICS_FEEDS=personal
SBICS_FEED_PERSONAL=https://calendar.example.com/your/secret/link.ics
# SBICS_FEEDS=personal,family
# SBICS_FEED_FAMILY=webcal://calendar.example.org/another/secret/link.ics

# The zone answers are given in (an IANA name). UTC when unset.
SBICS_TIMEZONE=America/Chicago

# Fetching: at most one fetch per feed this often (seconds), the deadline for one fetch
# (seconds), and the largest feed accepted (megabytes, after decompression).
# SBICS_MIN_FETCH_SECONDS=60
# SBICS_FETCH_TIMEOUT=30
# SBICS_MAX_FEED_MB=10

# HTTP mode, for a Claude custom connector (docs/remote-access.md).
# SBICS_TRANSPORT=http
# SBICS_HOST=127.0.0.1
# SBICS_PORT=8777
# SBICS_HTTP_PATH=/mcp
# SBICS_PUBLIC_URL=https://ics.example.com
# SBICS_GITHUB_CLIENT_ID=
# SBICS_GITHUB_CLIENT_SECRET=
# SBICS_JWT_SIGNING_KEY=
# SBICS_ALLOWED_GITHUB_IDS=
# SBICS_OAUTH_REDIRECT_URIS=
# SBICS_RATE_LIMIT_PER_MINUTE=60
